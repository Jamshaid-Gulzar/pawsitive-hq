# Nothing here is needed to run locally — the app uses ./local.db automatically.

# For the live site on Vercel, create a free Turso database and add:
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-token

# Optional: the facility's time zone, so "today" is right on a UTC server.
FACILITY_TIMEZONE=America/New_York
